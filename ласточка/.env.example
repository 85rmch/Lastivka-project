# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The URL of your Supabase project.
VITE_SUPABASE_URL=""

# SUPABASE_ANON_KEY: The public anon key for your Supabase project.
VITE_SUPABASE_ANON_KEY=""

# SUPABASE_SECRET_KEY: The secret key for your Supabase project.
VITE_SUPABASE_SECRET_KEY=""

# GITHUB_TOKEN: Token for GitHub REST API to upload images.
GITHUB_TOKEN=""

# GOOGLE_SHEETS_CREDENTIALS: JSON credentials for Google Sheets API.
GOOGLE_SHEETS_CREDENTIALS=""

# TELEGRAM_BOT_TOKEN: Bot token for Telegram.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: Chat ID for the group or channel where order notifications should be sent.
TELEGRAM_CHAT_ID=""

# ADMIN_PASSWORD: Password to enable Manager Mode and allow editing.
ADMIN_PASSWORD="lastochka_admin"
